# Copy to backend/.env (gitignored). Only the providers you use need a key.
RUNPOD_KEY=rpa_
VAST_API_KEY=
KAGGLE_USERNAME=
KAGGLE_KEY=
# GitHub token for private clone + pushing run .dvc stubs from GPU pods
GIT_PAT=
# DVC/S3 bucket created by Terraform: terraform output -raw dvc_bucket_name
REINFORCE_DVC_BUCKET=
# AWS profile used by dev/dvc setup (default: reinforce)
REINFORCE_AWS_PROFILE=reinforce
